{
  "name": "opencode-scribe",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.17.0",
  "publisher": "drmrStudio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zeug-zz/opencode-chat"
  },
  "homepage": "https://github.com/zeug-zz/opencode-chat#readme",
  "bugs": {
    "url": "https://github.com/zeug-zz/opencode-chat/issues"
  },
  "keywords": [
    "opencode",
    "ai",
    "chat",
    "llm",
    "research",
    "writing"
  ],
  "icon": "media/icon.png",
  "preview": true,
  "qna": false,
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:opencode-chat.chatView"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "opencode-chat",
          "title": "OpenCode",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "opencode-chat": [
        {
          "type": "webview",
          "id": "opencode-chat.chatView",
          "name": "Chat"
        }
      ]
    },
    "configuration": {
      "title": "OpenCode Scribe",
      "properties": {
        "opencode-chat.nono.profile": {
          "type": "string",
          "default": "",
          "scope": "workspace",
          "description": "%configuration.nonoProfile%"
        },
        "opencode-chat.chatSandbox.mode": {
          "type": "string",
          "enum": [
            "inherit",
            "on",
            "off"
          ],
          "default": "inherit",
          "scope": "window",
          "description": "Controls sandboxing for OpenCode Scribe tools."
        },
        "opencode-chat.chatSandbox.allowNetwork": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Allows network access for sandboxed OpenCode Scribe tools."
        }
      }
    },
    "commands": [
      {
        "command": "opencode-chat.selectNonoProfile",
        "title": "%command.selectNonoProfile%"
      },
      {
        "command": "opencode-chat.checkForUpdates",
        "title": "%command.checkForUpdates%"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs && node --experimental-strip-types scripts/stage-bundled-research-resources.ts && vite build",
    "build:ext": "node esbuild.mjs",
    "build:webview": "vite build",
    "watch:ext": "node esbuild.mjs --watch",
    "watch:webview": "vite build --watch",
    "test": "vitest run --config vitest.config.ts",
    "test:ext": "vitest run --config vitest.config.ext.ts",
    "test:ext:watch": "vitest --config vitest.config.ext.ts",
    "test:all": "vitest run --config vitest.config.ts && vitest run --config vitest.config.ext.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "package": "vsce package --no-dependencies",
    "verify-package": "node --experimental-strip-types scripts/verify-bundled-research-package.ts",
    "package:verify": "npm run package && npm run verify-package"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.138.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.0",
    "marked": "^18.0.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@opencode-chat/agent-opencode": "workspace:*",
    "@opencode-chat/core": "workspace:*",
    "dompurify": "^3.4.15",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.7",
    "marked-katex-extension": "^5.1.13",
    "mermaid": "^12.0.0",
    "react-icons": "^5.7.0"
  }
}
